---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ k8s_tsidp_name }}
  namespace: "{{ namespace_name }}"
  labels:
    app.kubernetes.io/name: {{ k8s_tsidp_name }}
spec:
  revisionHistoryLimit: 3
  replicas: {{ k8s_tsidp_replicas }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ k8s_tsidp_name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ k8s_tsidp_name }}
    spec:
      containers:
        - name: {{ k8s_tsidp_name }}
          image: "{{ k8s_tsidp_image }}"
          imagePullPolicy: {{ k8s_tsidp_image_pull_policy }}
          env:
            - name: TAILSCALE_USE_WIP_CODE
              value: "1"
            - name: TS_STATE_DIR
              value: /data
            - name: TS_HOSTNAME
              value: "{{ k8s_tsidp_hostname }}"
            - name: TSIDP_ENABLE_STS
              value: "{{ '1' if k8s_tsidp_enable_sts else '0' }}"
          ports:
            - name: https
              containerPort: {{ k8s_tsidp_port }}
              protocol: TCP
          volumeMounts:
            - mountPath: /data
              name: tsidp-data
      volumes:
        - name: tsidp-data
          persistentVolumeClaim:
            claimName: {{ k8s_tsidp_name }}-data
