---
apiVersion: v1
kind: Service
metadata:
  name: {{ k8s_tsidp_name }}
  namespace: "{{ namespace_name }}"
  labels:
    app.kubernetes.io/name: {{ k8s_tsidp_name }}
spec:
  type: ClusterIP
  ports:
    - port: {{ k8s_tsidp_port }}
      targetPort: https
      protocol: TCP
      name: https
  selector:
    app.kubernetes.io/name: {{ k8s_tsidp_name }}
