---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ homepage_name }}
  namespace: {{ namespace_name }}
  labels:
    app.kubernetes.io/name: {{ homepage_name }}
  annotations:
    gethomepage.dev/description: "Dynamically Detected Homepage"
    gethomepage.dev/enabled: "true"
    gethomepage.dev/group: "Cluster Management"
    gethomepage.dev/icon: "homepage.png"
    gethomepage.dev/name: "Homepage"
spec:
  ingressClassName: {{ homepage_ingress_class_name }}
  rules:
    - host: "{{ homepage_ingress_host }}"
      http:
        paths:
          - path: "{{ homepage_ingress_path }}"
            pathType: {{ homepage_ingress_path_type }}
            backend:
              service:
                name: {{ homepage_name }}
                port:
                  number: 3000
  tls:
    - hosts:
        - "{{ homepage_ingress_host }}"
