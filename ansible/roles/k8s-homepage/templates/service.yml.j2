---
apiVersion: v1
kind: Service
metadata:
  name: {{ homepage_name }}
  namespace: {{ namespace_name }}
  labels:
    app.kubernetes.io/name: {{ homepage_name }}
spec:
  type: ClusterIP
  ports:
    - port: 3000
      targetPort: http
      protocol: TCP
      name: http
  selector:
    app.kubernetes.io/name: {{ homepage_name }}
