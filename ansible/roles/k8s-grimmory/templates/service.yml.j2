---
apiVersion: v1
kind: Service
metadata:
  name: {{ grimmory_name }}
  namespace: "{{ namespace_name }}"
  labels:
    app.kubernetes.io/name: {{ grimmory_name }}
spec:
  type: ClusterIP
  ports:
    - port: {{ grimmory_port }}
      targetPort: http
      protocol: TCP
      name: http
  selector:
    app.kubernetes.io/name: {{ grimmory_name }}
