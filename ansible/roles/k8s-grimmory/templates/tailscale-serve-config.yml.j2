---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ grimmory_tailscale_serve_config_name }}
  namespace: "{{ namespace_name }}"
data:
  serve.json: |
    {
      "TCP": {
        "443": {
          "HTTPS": true
        }
      },
      "Web": {
        "${TS_CERT_DOMAIN}:443": {
          "Handlers": {
            "/": {
              "Proxy": "http://127.0.0.1:{{ grimmory_port }}"
            }
          }
        }
      }
    }
