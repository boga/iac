---
apiVersion: v1
kind: Secret
metadata:
  name: grimmory-db
  namespace: "{{ namespace_name }}"
type: Opaque
stringData:
  DATABASE_URL: "jdbc:mariadb://{{ grimmory_db_host }}:{{ grimmory_db_port }}/{{ grimmory_db_name }}?allowPublicKeyRetrieval=true&useSSL=false"
  DATABASE_USERNAME: "{{ grimmory_db_user }}"
