---
apiVersion: v1
kind: Secret
metadata:
  name: grimmory-db
  namespace: {{ namespace_name }}
type: Opaque
stringData:
  DATABASE_URL: "jdbc:mariadb://{{ grimmory_db_host }}:{{ grimmory_db_port }}/{{ grimmory_db_name }}"
  DATABASE_USERNAME: "{{ grimmory_db_user }}"
  DATABASE_PASSWORD: "{{ grimmory_db_password }}"
  MYSQL_ROOT_PASSWORD: "{{ grimmory_mariadb_root_password }}"
  MYSQL_DATABASE: "{{ grimmory_db_name }}"
  MYSQL_USER: "{{ grimmory_db_user }}"
  MYSQL_PASSWORD: "{{ grimmory_db_password }}"