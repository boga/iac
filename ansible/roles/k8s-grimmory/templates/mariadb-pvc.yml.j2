---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: grimmory-mariadb-config
  namespace: {{ namespace_name }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ grimmory_storage_class_name | default('local-path') }}
  resources:
    requests:
      storage: {{ grimmory_mariadb_storage_size | default('5Gi') }}