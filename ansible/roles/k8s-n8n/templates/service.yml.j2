---
apiVersion: v1
kind: Service
metadata:
  name: {{ n8n_name }}
  namespace: "{{ namespace_name }}"
  labels:
    app.kubernetes.io/name: {{ n8n_name }}
spec:
  type: ClusterIP
  ports:
    - name: http
      port: {{ n8n_port }}
      targetPort: http
      protocol: TCP
  selector:
    app.kubernetes.io/name: {{ n8n_name }}
