---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ n8n_name }}-tailscale
  namespace: "{{ namespace_name }}"
  annotations:
    gethomepage.dev/description: Workflow automation
    gethomepage.dev/enabled: "true"
    gethomepage.dev/group: homelab
    gethomepage.dev/name: n8n
  labels:
    app.kubernetes.io/name: {{ n8n_name }}
spec:
  ingressClassName: tailscale
  tls:
    - hosts:
        - "{{ n8n_tailscale_hostname }}"
  rules:
    - host: "{{ n8n_tailscale_hostname }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ n8n_name }}
                port:
                  name: http
