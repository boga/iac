apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: {{ signoz_host_collector_name }}
  namespace: {{ namespace_name }}
  labels:
    app.kubernetes.io/name: signoz-host-collector
    app.kubernetes.io/component: telemetry
    app.kubernetes.io/instance: {{ signoz_host_collector_name }}
    app.kubernetes.io/part-of: signoz
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: signoz-host-collector
      app.kubernetes.io/instance: {{ signoz_host_collector_name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: signoz-host-collector
        app.kubernetes.io/component: telemetry
        app.kubernetes.io/instance: {{ signoz_host_collector_name }}
        app.kubernetes.io/part-of: signoz
    spec:
      serviceAccountName: {{ signoz_host_collector_name }}
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      tolerations:
        - key: "node-role.kubernetes.io/control-plane"
          operator: Exists
          effect: NoSchedule
        - key: "node-role.kubernetes.io/master"
          operator: Exists
          effect: NoSchedule
      containers:
        - name: otel-collector
          image: otel/opentelemetry-collector-contrib:0.99.0
          imagePullPolicy: IfNotPresent
          args: ["--config=/conf/collector.yaml"]
          env:
            - name: KUBE_NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: NODE_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.hostIP
          volumeMounts:
            - name: collector-config
              mountPath: /conf
            - name: varlog
              mountPath: /var/log
              readOnly: true
            - name: containerd-sock
              mountPath: /run/containerd/containerd.sock
              readOnly: true
            - name: docker-sock
              mountPath: /var/run/docker.sock
              readOnly: true
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 1Gi
      volumes:
        - name: collector-config
          configMap:
            name: {{ signoz_host_collector_name }}-config
        - name: varlog
          hostPath:
            path: /var/log
        - name: containerd-sock
          hostPath:
            path: /run/containerd/containerd.sock
            type: Socket
        - name: docker-sock
          hostPath:
            path: /var/run/docker.sock
            type: Socket
