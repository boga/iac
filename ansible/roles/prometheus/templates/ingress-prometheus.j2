---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: prometheus
  labels:
    app: prometheus
  annotations:
    ingress.kubernetes.io/rewrite-target: /
spec:
  rules:
    - host: "prometheus.looner.lan"
      http:
        paths:
          - backend:
              service:
                name: kube-prometheus-stack-prometheus
                port: 
                  name: http-web
            path: /
            pathType: Prefix
